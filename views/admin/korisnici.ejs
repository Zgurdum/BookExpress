<!DOCTYPE html>
<html lang="hr">
<head>
    <link rel="icon" type="image/x-icon" href="/images/book.png">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Upravljanje Korisnicima</title>
    <link rel="stylesheet" href="/stylesheets/admin-style.css">
</head>
<body>
    <%- include('../iskoristivi/admin-header') %> 

    <main class="admin-container">
        <div class="table-header">
            <h1 class="page-title">Upravljanje korisnicima</h1>
            <div class="search-box">
                <input type="text" id="userSearch" placeholder="Pretraži po imenu ili emailu..." onkeyup="filterUsers()">
            </div>
        </div>

        <div class="table-section">
            <table class="stats-table" id="usersTable">
                <thead>
                    <tr>
                        <th>Ime i Prezime</th>
                        <th>Email</th>
                        <th>Uloga</th>
                        <th>Status</th>
                        <th>Akcije</th>
                    </tr>
                </thead>
                <tbody>
                    <% users.forEach(user => { %>
                        <tr>
                            <td><strong><%= user.ime %> <%= user.prezime %></strong></td>
                            <td><%= user.email %></td>
                            <td><span class="badge uloga-<%= user.uloga %>"><%= user.uloga %></span></td>
                            <td>
                                <select class="status-select" onchange="changeStatus('<%= user.id %>', this.value)">
                                    <option value="aktivan" <%= user.status_naloga === 'aktivan' ? 'selected' : '' %>>Aktivan</option>
                                    <option value="neaktivan" <%= user.status_naloga === 'neaktivan' ? 'selected' : '' %>>Neaktivan</option>
                                    <option value="blokiran" <%= user.status_naloga === 'blokiran' ? 'selected' : '' %>>Blokiran</option>
                                    <option value="arhiviran" <%= user.status_naloga === 'arhiviran' ? 'selected' : '' %>>Arhiviran</option>
                                </select>
                            </td>
                            <td class="actions-cell">
                                <a href="/messages/<%= user.id %>" class="btn btn-message" title="Pošalji poruku">
                                    <img src="/images/message-icon.png" alt="Chat" style="width: 18px; vertical-align: middle;">
                                </a>
                                <button class="btn btn-block" onclick="openBlockModal('<%= user.id %>', '<%= user.ime %>')">Blokiraj</button>
                                <button class="btn btn-archive" onclick="archiveUser('<%= user.id %>')">Arhiviraj</button>
                            </td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
    </main>

    <div id="blockModal" class="modal">
        <div class="modal-content">
            <h3>Blokiraj korisnika: <span id="modalUserName"></span></h3>
            <p>Odaberite trajanje blokade:</p>
            <div class="modal-actions">
                <button onclick="submitBlock('15_days')" class="btn btn-warning">Privremeno (15 dana)</button>
                <button onclick="submitBlock('permanent')" class="btn btn-danger">Trajni blok</button>
                <button onclick="closeBlockModal()" class="btn btn-secondary">Odustani</button>
            </div>
        </div>
    </div>

    <script>
        let selectedUserId = null;

        // API proba
        async function changeStatus(userId, status) {
            const response = await fetch('/admin/korisnici/change-status', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ userId, status })
            });
            if (response.ok) location.reload();
        }

        // Otvaranje modala
        function openBlockModal(userId, userName) {
            selectedUserId = userId;
            document.getElementById('modalUserName').innerText = userName;
            document.getElementById('blockModal').style.display = 'flex';
        }

        function closeBlockModal() {
            document.getElementById('blockModal').style.display = 'none';
        }

        // Slanje zahtjeva za blokadu
        async function submitBlock(type) {
            const response = await fetch('/admin/korisnici/block', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ userId: selectedUserId, type })
            });
            if (response.ok) location.reload();
        }

        // Arhiviranje
        async function archiveUser(userId) {
            if (confirm('Jeste li sigurni da želite arhivirati ovog korisnika?')) {
                const response = await fetch(`/admin/korisnici/archive/${userId}`, { method: 'DELETE' });
                if (response.ok) location.reload();
            }
        }

        // Jednostavna pretraga u tabeli
        function filterUsers() {
            let input = document.getElementById('userSearch').value.toLowerCase();
            let rows = document.querySelectorAll('#usersTable tbody tr');
            rows.forEach(row => {
                let text = row.innerText.toLowerCase();
                row.style.display = text.includes(input) ? '' : 'none';
            });
        }
    </script>
</body>
</html>