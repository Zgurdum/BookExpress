<!DOCTYPE html>
<html lang="hr">
<head>
    <link rel="icon" type="image/x-icon" href="/images/book.png">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/stylesheets/admin-style.css">
</head>
<body>
    <%- include('../iskoristivi/admin-header') %> 

    <main class="admin-container">
        <div class="table-header">
            <h1 class="page-title">Upravljanje prijavama</h1>
        </div>

        <div class="table-section">
            <table class="stats-table">
                <thead>
                    <tr>
                        <th>Prijavio</th>
                        <th>Prijavljeni</th>
                        <th>Naslov</th>
                        <th>Sadržaj</th>
                        <th>Status</th>
                        <th>Datum</th>
                    </tr>
                </thead>
                <tbody>
                    <% reports.forEach(report => { %>
                        <tr>
                            <td><%= report.Reporter.ime %> <%= report.Reporter.prezime %></td>
                            <td><%= report.PrijavljeniKorisnik.ime %> <%= report.PrijavljeniKorisnik.prezime %></td>
                            <td><%= report.title %></td>
                            <td><%= report.content %></td>
                            <td>
                                <span class="badge status-<%= report.status %>"><%= report.status %></span>
                            </td>
                            <td><%= new Date(report.createdAt).toLocaleDateString('hr-HR') %></td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
    </main>

</body>
</html>
