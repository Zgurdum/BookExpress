<!DOCTYPE html>
<html lang="bs">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Profil</title>
    <link rel="icon" type="image/x-icon" href="/images/book.png">
    <link rel="stylesheet" href="/stylesheets/style.css">
    <link rel="stylesheet" href="/stylesheets/profile.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    <!-- SweetAlert2 CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11.7.32/dist/sweetalert2.min.css">
    <script src="/javascripts/sorting.js" defer></script>
    <script src="/javascripts/alerts.js"></script>
</head>
<script>

    function openTab(evt, tabName) {
        // Sakrij sve tabove
        const tabContent = document.getElementsByClassName("tab-content");
        for (let i = 0; i < tabContent.length; i++) {
            tabContent[i].classList.remove("active");
        }

        // Deaktiviraj sve dugmiće
        const tabBtns = document.getElementsByClassName("tab-btn");
        for (let i = 0; i < tabBtns.length; i++) {
            tabBtns[i].classList.remove("active");
        }

        // Prikaži kliknuti tab i označi dugme aktivnim
        document.getElementById(tabName).classList.add("active");
        evt.currentTarget.classList.add("active");
    }
</script>
<body>
    <script src="https://unpkg.com/lenis@1.1.20/dist/lenis.min.js"></script>
    <script src="/javascripts/smooth-scroll.js"></script>
    <%- include('./iskoristivi/header.ejs') %>

    <main class="profile-page-container">
        <div class="profile-main-layout">
            
            <aside class="profile-sidebar">
                <div class="profile-header-card">
                    
                    <div class="profile-avatar-wrapper">
                        <% if (profilUser.profilna_slika_url) { %>
                            <img src="<%= profilUser.profilna_slika_url %>" alt="Profilna" class="card-avatar">
                        <% } else { %>
                            <div class="card-avatar-placeholder">
                                <i class="fas fa-user"></i>
                            </div>
                        <% } %>
                    </div>

                    <h2><%= profilUser.ime %> <%= profilUser.prezime %></h2>
                    
                    <hr>

                    <div class="profile-info-list">
                        <p><i class="fas fa-envelope"></i> <strong>Email</strong> <%= profilUser.email %></p>
                        <p><i class="fas fa-user-tag"></i> <strong>Uloga</strong> <%= profilUser.uloga %></p>
                        <p><i class="fas fa-check-circle"></i> <strong>Status</strong> <%= profilUser.status %></p>
                    </div>

                    <% if (jeMojProfil) { %>
                        <div class="profile-actions">
                            <a href="/users/profil/edit" class="button edit-button">
                                <i class="fas fa-edit"></i> Uredi profil
                            </a>
                            <form action="/auth/logout" method="POST" class="logout-form">
                                <button type="submit" class="button danger-button">
                                    <i class="fas fa-sign-out-alt"></i> Odjavi se
                                </button>
                            </form>
                        </div>
                    <% } else { %> <!--Samo na tudjim profilima renderuje report-->
                        <div class="profile-actions">
                            <a href="/reports/<%= profilUser.id %>" class="button warning-button">
                                <i class="fas fa-flag"></i> Prijavi korisnika
                            </a>
                        </div>
                    <% } %>
                </div>
            </aside>

            <section class="profile-main-content">
                
                <div class="profile-tabs">
                    <button class="tab-btn active" onclick="openTab(event, 'aktivni')">
                        <i class="fas fa-book-open"></i> Aktivni oglasi
                    </button>
                    <button class="tab-btn" onclick="openTab(event, 'zavrseni')">
                        <i class="fas fa-check-circle"></i> Završeni oglasi
                    </button>
                    <button class="tab-btn" onclick="openTab(event, 'recenzije-tab')">
                        <i class="fas fa-star"></i> Recenzije
                    </button>
                </div>
                            <div class="filter-controls">
                            <input type="text" id="searchName" placeholder="Pretraži po imenu..." onkeyup="filterBooks()">
                            
                            <select id="sortPrice" onchange="filterBooks()">
                                <option value="default">Cijena: Svi</option>
                                <option value="low">Najniža prvo</option>
                                <option value="high">Najviša prvo</option>
                            </select>

                            <select id="sortDate" onchange="filterBooks()">
                                <option value="newest">Najnovije</option>
                                <option value="oldest">Najstarije</option>
                            </select>
                        </div>

                <div id="aktivni" class="tab-content active">
                    <h3>Knjige na Prodaji/Razmjeni (<%= knjige.length %>)</h3> 
                    <div class="book-grid-container">
                        <% if (knjige && knjige.length > 0) { %>
                            <% knjige.forEach(book => { %>
                                <div class="book-card" 
                                    data-name="<%= book.naziv.toLowerCase() %>" 
                                    data-price="<%= book.cijena %>" 
                                    data-date="<%= new Date(book.createdAt).getTime()%>">
                                    <img src="<%= book.fotografija_url %>" alt="<%= book.naziv %>">
                                    <div class="book-info">
                                        <h4><%= book.naziv %></h4>
                                        <p><%= book.autor %></p>
                                        <span class="book-price"><%= book.cijena %> KM</span>
                                        <div class="book-actions"> 
                                            <a href="/knjige/<%= book.id %>" class="details-link">Detalji</a>
                                            <% if (jeMojProfil) { %>
                                                <form action="/knjige/delete/<%= book.id %>?_method=DELETE" method="POST" style="display: inline;">
                                                    <button type="submit" class="delete-button" title="Obriši knjigu" onclick="return confirm('Jeste li sigurni?');">
                                                        <i class="fas fa-trash-alt"></i> 
                                                    </button>
                                                </form>
                                            <% } %>
                                        </div>
                                    </div>
                                </div>
                            <% }); %>
                        <% } else { %>
                            <p class="no-books-message">Trenutno nema aktivnih oglasa.</p>
                        <% } %>
                    </div>
                </div>

                <div id="zavrseni" class="tab-content">
                    <h3>Završeni oglasi / Prodano (<%= typeof zavrseniOglasi !== 'undefined' ? zavrseniOglasi.length : 0 %>)</h3>
                    <div class="book-grid-container">
                        <% if (typeof zavrseniOglasi !== 'undefined' && zavrseniOglasi.length > 0) { %>
                            <% zavrseniOglasi.forEach(book => { %>
                                <div class="book-card sold-item"> 
                                    <img src="<%= book.fotografija_url %>" alt="<%= book.naziv %>" style="filter: grayscale(80%);">
                                    <div class="book-info">
                                        <h4><%= book.naziv %></h4>
                                        <p><%= book.autor %></p>
                                        <span class="book-price" style="text-decoration: line-through;"><%= book.cijena %> KM</span>
                                        <div class="book-actions"> 
                                            <a href="/knjige/<%= book.id %>" class="details-link">Pregledaj oglas</a>
                                        </div>
                                    </div>
                                </div>
                            <% }); %>
                        <% } else { %>
                            <p class="no-books-message">Nema završenih prodaja.</p>
                        <% } %>
                    </div>
                </div>

                <div id="recenzije-tab" class="tab-content">
                    <h3>Recenzije korisnika (<%= typeof prosjecnaOcjena !== 'undefined' ? prosjecnaOcjena : 'Nema ocjena' %> ★)</h3>
                    <div class="reviews-container">
                        <% if (typeof recenzije !== 'undefined' && recenzije.length > 0) { %>
                            <% recenzije.forEach(r => { %>
                                <div class="review-card-modern">
                                    <div class="review-header">
                                        <strong><%= r.KupacRecenzent.ime %></strong>
                                        <span class="stars"><%= "★".repeat(r.ocjena) %><%= "☆".repeat(5-r.ocjena) %></span>
                                    </div>
                                    <p>"<%= r.komentar %>"</p>
                                    <small><%= new Date(r.datum_recenzije).toLocaleDateString() %></small>
                                </div>
                            <% }) %>
                        <% } else { %>
                            <p class="no-books-message">Korisnik još uvijek nema recenzija.</p>
                        <% } %>
                    </div>
                </div>
            </section>
        </div>
    </main>

    <!-- SweetAlert2 JavaScript -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.7.32/dist/sweetalert2.all.min.js"></script>
    <script>
        // sweetalret
        const urlParams = new URLSearchParams(window.location.search);
        const successMessage = urlParams.get('success');
        const errorMessage = urlParams.get('error');

        if (successMessage) {
            document.addEventListener('DOMContentLoaded', function() {
                showSuccessAlert(decodeURIComponent(successMessage));
            });
        }

        if (errorMessage) {
            document.addEventListener('DOMContentLoaded', function() {
                showErrorAlert(decodeURIComponent(errorMessage));
            });
        }
    </script>

</body>