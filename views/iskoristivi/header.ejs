<!DOCTYPE html>
<html lang="bs">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>BookExpress</title>
    <link rel="stylesheet" href="/stylesheets/header.css">
    <!-- SweetAlert2 CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11.7.32/dist/sweetalert2.min.css">
    <script src="/javascripts/headerSkripte.js"></script>
    <script src="/javascripts/alerts.js"></script>
</head>
<% if (isAuthenticated) { %>
    <div class="bottom-nav">
        <li><a href="/"><img src="/images/home.png" alt="Company Logo" class="nav-icon-mobile"></a></li>
        <li><a href="/messages"><img src="/images/comment.png" alt="Company Logo" class="nav-icon-mobile"></a></li>
        <li><a href="/knjige/add" class="objavi-artikl">+ Objavi Knjigu</a></li> 
        <li>
            <a href="javascript:void(0)" class="notification-trigger" onclick="toggleNotifications()">
                    <img src="/images/notification.png" alt="Obavijesti" class="nav-icon-mobile">
                    <span id="notif-badge" class="badge" style="display: none;">0</span>
            </a>
        </li>
        <li>
            <a href="javascript:void(0)" class="cart-trigger" onclick="toggleCart()">
                <img src="/images/shopping-cart.png" alt="Company Logo" class="nav-icon-mobile">
            </a>
        </li> 
    </div>
<% } else { %>
                
        <% } %>

<header class="main-header">
    <div class="site-branding">
        <a href="/" class="logo-link">
            <h1>BookExpress</h1>
        </a>
    </div>
    
    <nav class="main-nav">
        <ul>
            
            <% if (isAuthenticated) { %>
                <li><a href="/knjige/add" class="objavi-artikl-desktop">+ Objavi Knjigu</a></li> 
                <li><a href="/messages"><img src="/images/comment.png" alt="Company Logo" class="nav-icon"></a></li>
                <li>
                    <a href="javascript:void(0)" class="notification-trigger" onclick="toggleNotifications()">
                        <img src="/images/notification.png" alt="Obavijesti" class="nav-icon">
                        <span id="notif-badge" class="badge" style="display: none;">0</span>
                    </a>
                </li>
                
                <li>
                    <a href="javascript:void(0)" class="cart-trigger" onclick="toggleCart()">
                        <img src="/images/shopping-cart.png" alt="Company Logo" class="nav-icon">
                    </a>
                </li> 
                
               <li class="user-menu-container">
                    <div class="user-profile-wrapper">
                        <li><a href="/users/profil/"><img src="/images/user.png" alt="Company Logo" class="nav-icon"></a></li>
                        <button class="hamburger-btn" onclick="toggleUserMenu()">
                            <span></span>
                            <span></span>
                            <span></span>
                        </button>
                    </div>
                    
                    <div id="user-dropdown" class="user-dropdown">
                        <a href="/orders/moje-narudzbe">Moje narudžbe</a>
                        <a href="/recenzija/moji-komentari">Moje recenzije</a>
                        <a href="/users/profil">Moj profil</a>
                        <hr>
                        <form action="/auth/logout" method="POST" class="logout-form">
                            <button type="submit" class="button danger-button">
                                    <i class="fas fa-sign-out-alt"></i> Odjavi se
                            </button>
                        </form>
                    </div>
                </li>
                                        

            <% } else { %>
                <li><a href="/auth/login">Prijava</a></li>
                <li><a href="/auth/register" class="button primary-button">Registracija</a></li>
                
            <% } %>
        </ul>
    </nav>
</header>

<div id="notif-overlay" class="cart-overlay" onclick="toggleNotifications()"></div>

<div id="cart-overlay" class="cart-overlay" onclick="toggleCart()"></div>

<aside id="cart-drawer" class="cart-drawer">
    <div class="cart-header">
        <h3>Vaša Korpa</h3>
        <button class="close-drawer" onclick="toggleCart()">&times;</button>
    </div>

    <div class="cart-items-list" id="cart-items">
        <p class="empty-msg">Korpa je prazna.</p>
    </div>

    <div class="cart-footer">
        <div class="total-price-row">
            <span>Ukupno:</span>
            <span id="cart-total-amount">0.00 KM</span>
        </div>
        <button class="checkout-button" onclick="goToCheckout()">Završi narudžbu</button>
    </div>
</aside>

<aside id="notif-drawer" class="cart-drawer">
    <div class="cart-header">
        <h3>Obavijesti za prodaju</h3>
        <button class="close-drawer" onclick="toggleNotifications()">&times;</button>
    </div>

    <div class="cart-items-list" id="notif-items">
        <p class="empty-msg">Nema novih upita za prodaju.</p>
    </div>
</aside>

<!-- SweetAlert2 JavaScript -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.7.32/dist/sweetalert2.all.min.js"></script>
